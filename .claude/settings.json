{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make *)",
      "Bash(luajit *)",
      "Bash(python3 tools/*)",
      "Bash(python3 -I tools/*)",
      "Bash(./tools/*)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Read(./.audit_src/**)"
    ],
    "ask": [
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(git push *)",
      "Bash(git commit *)"
    ],
    "deny": [
      "Edit(./.audit_src/**)",
      "Write(./.audit_src/**)",
      "Bash(rm -rf *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/check_edit.py"],
            "timeout": 30,
            "statusMessage": "Contrôle du fichier modifié"
          }
        ]
      }
    ]
  }
}
